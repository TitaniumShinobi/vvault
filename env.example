# VVAULT Environment Configuration
# Copy this file to .env and modify as needed

# Flask/JWT Configuration
SECRET_KEY=your-super-secret-key-change-in-production
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Server Configuration
VVAULT_PORT=8000
VVAULT_FRONTEND_URL=http://localhost:7784
VVAULT_BACKEND_URL=http://localhost:8000

# CORS Configuration
CORS_ORIGINS=http://localhost:7784,http://localhost:5173

# Cloudflare Turnstile (Human Verification)
# Get your keys from: https://developers.cloudflare.com/turnstile/
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# OAuth Configuration (for unified user registry)
# These credentials should match Chatty and CleanHouse for unified authentication

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret  # Optional, PKCE is used for security

# Microsoft OAuth (Azure AD)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret  # Optional, PKCE is used for security

# Apple OAuth (Sign in with Apple)
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret  # Required for Apple

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret  # Required for GitHub

# VVAULT-native Database Configuration
# Runtime body/auth/file persistence is owned by local Postgres.
DATABASE_URL=postgresql://vvault:vvault@postgres:5432/vvault
# Optional body DB override when the imported body lives in a dedicated local DB.
# VVAULT_BODY_DATABASE_NAME=vvault_body_20260504t123219z
# VVAULT_BODY_DATABASE_URL=postgresql://vvault:vvault@postgres:5432/vvault_body_20260504t123219z

# Optional Redis cache/queue dependency
REDIS_URL=redis://redis:6379/0

# VVAULT-native S3-compatible object storage
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=vvault

# Migration/offboarding only: legacy Supabase extraction source.
# Install optional dependencies with the legacy-supabase-migration extra before using these.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key

# Session Configuration
SESSION_SECRET=your-session-secret-key-change-in-production
SESSION_TIMEOUT=3600  # Session timeout in seconds (default: 1 hour)
SESSION_HASH_PEPPER=local-dev-random-string
SESSION_TTL_SECONDS=604800

# Security Configuration
ALLOWED_ORIGINS=http://localhost:7784,http://localhost:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100  # Requests per window
RATE_LIMIT_WINDOW=60     # Window in seconds
VVAULT_SERVICE_TOKEN=your-secure-service-token

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/vvault.log

# Development/Production Mode
NODE_ENV=development
# Options: development, production, test

# Optional: Email Configuration (for email verification)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_FROM=noreply@vvault.com

# Optional: Vector Database (ChromaDB/FAISS)
# CHROMADB_PATH=./chromadb
# CHROMADB_COLLECTION=vvault_memories

# Optional: Blockchain Configuration (if using blockchain features)
# BLOCKCHAIN_NETWORK=ethereum
# BLOCKCHAIN_RPC_URL=https://mainnet.infura.io/v3/your-project-id
# WALLET_PRIVATE_KEY=your-wallet-private-key  # NEVER commit this!

# Optional: External API Keys
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Standalone @auth integration (dev) ---
# Run a second auth process for VVAULT (Code may already use AUTH_PORT=1111):
#   AUTH_PORT=1122 AUTH_APP_CONFIG_PATH=../auth/config/vvault.json AUTH_SESSION_SECRET=<same-as-below> npm run start --prefix ../auth
# Keep shared-auth parity when you do this:
# - AUTH_APP_CONFIG_PATH should keep pointing at the VVAULT auth config (`../auth/config/vvault.json` from this repo, or `config/vvault.json` inside `auth/`)
# - AUTH_SESSION_SECRET must match between the auth process and VVAULT's Flask session bridge
# - AUTH_COOKIE_NAME must match too if you override auth's default cookie name
# Google Cloud: authorized redirect URI http://localhost:7784/api/auth/google/callback
# VVAULT_GOOGLE_CLIENT_ID=
# VVAULT_GOOGLE_CLIENT_SECRET=
# VVAULT_PUBLIC_CALLBACK_BASE=http://localhost:7784
# Shared secret: Flask session-bridge verifies @auth cookies with the same value as auth uses for session tokens.
# AUTH_SESSION_SECRET=change-me-same-in-both-processes
# Optional cookie name if you override in auth (default auth_sid):
# AUTH_COOKIE_NAME=auth_sid
# Direct PostgREST JWTs are issued by auth and verified by PostgREST. Do not reuse AUTH_SESSION_SECRET.
# AUTH_POSTGREST_JWT_SECRET=change-me-postgrest
# AUTH_POSTGREST_JWT_TTL_SECONDS=900
# Legacy Chatty session exchange is disabled by default; only enable it for narrow internal rollback windows.
# VVAULT_ENABLE_LEGACY_CHATTY_SESSION_EXCHANGE=false
# Webpack dev proxy target for /api/auth (set when running webpack, e.g. in shell): VVAULT_AUTH_PROXY_TARGET=http://localhost:1122
# Faster local Flask bind (skips Pocketverse boot_sequence):
# VVAULT_SKIP_POCKETVERSE_BOOT=1
