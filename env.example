# VVAULT Environment Configuration
# Copy this file to .env and replace every placeholder with a deployment secret.

# Flask/JWT Configuration
SECRET_KEY=<generate-a-unique-session-secret>

# Server Configuration
VVAULT_PORT=8000
VVAULT_FRONTEND_URL=http://localhost:7784
VVAULT_BACKEND_URL=http://localhost:8000

# CORS Configuration
CORS_ORIGINS=http://localhost:7784,http://localhost:5173

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=<turnstile-site-key>
TURNSTILE_SECRET_KEY=<turnstile-secret-key>

# OAuth Configuration
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
MICROSOFT_CLIENT_ID=<microsoft-client-id>
MICROSOFT_CLIENT_SECRET=<microsoft-client-secret>
APPLE_CLIENT_ID=<apple-client-id>
APPLE_CLIENT_SECRET=<apple-client-secret>
GITHUB_CLIENT_ID=<github-client-id>
GITHUB_CLIENT_SECRET=<github-client-secret>

# Database Configuration
# Never commit a real connection string or password.
MONGODB_URI=mongodb://<username>:<password>@<host>:27017/<database>?authSource=admin
VVAULT_DB_PATH=./vvault.db

# Session and enrollment security
SESSION_SECRET=<generate-a-unique-session-secret>
SESSION_TIMEOUT=3600
# Independent 32+ character secret; do not reuse SECRET_KEY or SESSION_SECRET.
VVAULT_ENROLLMENT_HMAC_KEY=<generate-a-unique-32-plus-character-secret>

# Security Configuration
ALLOWED_ORIGINS=http://localhost:7784,http://localhost:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/vvault.log

# Development/Production Mode
NODE_ENV=development
