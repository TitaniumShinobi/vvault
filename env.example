# VVAULT Environment Configuration
# Copy this file to .env and modify as needed

# Flask/JWT Configuration
SECRET_KEY=your-super-secret-key-change-in-production
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Server Configuration
VVAULT_PORT=8000
VVAULT_FRONTEND_URL=http://localhost:7784
VVAULT_BACKEND_URL=http://localhost:8000

# CORS Configuration
CORS_ORIGINS=http://localhost:7784,http://localhost:5173

# Cloudflare Turnstile (Human Verification)
# Get your keys from: https://developers.cloudflare.com/turnstile/
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# OAuth Configuration for VVAULT-native browser enrollment.
# Use a contractor-owned OAuth client registered for the callback below.

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Microsoft OAuth (Azure AD)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret  # Optional, PKCE is used for security

# Apple OAuth (Sign in with Apple)
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret  # Required for Apple

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret  # Required for GitHub

# Canonical body/auth database. The current runtime does not use a local
# database fallback; supply a contractor-owned development database URL.
VVAULT_BODY_DATABASE_URL=postgresql://user:password@localhost:5432/vvault_body

# Enrollment integrity material. Generate unique local values; never commit
# the filled .env file.
VVAULT_ENROLLMENT_HMAC_KEY=replace-with-at-least-32-random-characters
VVAULT_OAUTH_TRANSACTION_ENCRYPTION_KEY=replace-with-a-valid-fernet-key

# Optional: Local SQLite fallback (if MongoDB unavailable)
VVAULT_DB_PATH=./vvault.db

# Session Configuration
SESSION_SECRET=your-session-secret-key-change-in-production
SESSION_TIMEOUT=3600  # Session timeout in seconds (default: 1 hour)

# Security Configuration
ALLOWED_ORIGINS=http://localhost:7784,http://localhost:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100  # Requests per window
RATE_LIMIT_WINDOW=60     # Window in seconds

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/vvault.log

# Development/Production Mode
NODE_ENV=development
# Options: development, production, test

# Chatty durable-execution verification keys (public material only).
# Prefer absolute regular files owned by the service user and not group/other-writable.
# File and inline forms are mutually exclusive; configuring both fails readiness.
# CHATTY_EXECUTION_AUTHORIZATION_PUBLIC_KEY_FILE=/absolute/path/chatty-execution-authorization-public.pem
# CHATTY_EXECUTION_AUTHORIZATION_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----..."
# CHATTY_EXECUTION_AUTHORIZATION_KEY_ID=<sha256-of-ed25519-spki-der>
# CHATTY_WORK_EXECUTION_HOST_KEYS_FILE=/absolute/path/chatty-execution-host-keys.json
# CHATTY_WORK_EXECUTION_HOST_KEYS_JSON={"host-id":{"keyId":"<sha256>","publicKeyPem":"-----BEGIN PUBLIC KEY-----..."}}

# Optional: Email Configuration (for email verification)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_FROM=noreply@vvault.com

# Optional: Vector Database (ChromaDB/FAISS)
# CHROMADB_PATH=./chromadb
# CHROMADB_COLLECTION=vvault_memories

# Optional: Blockchain Configuration (if using blockchain features)
# BLOCKCHAIN_NETWORK=ethereum
# BLOCKCHAIN_RPC_URL=https://mainnet.infura.io/v3/your-project-id
# WALLET_PRIVATE_KEY=your-wallet-private-key  # NEVER commit this!

# Optional: External API Keys
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
